{
  "name": "@lvce-editor/language-features-markdown-node",
  "version": "0.0.0-dev",
  "description": "Node adapter for the Markdown language server",
  "license": "MIT",
  "author": "LVCE Editor",
  "type": "module",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --bail --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-markdown-languageserver": "^0.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.3",
    "@types/markdown-it": "^14.1.2"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
