{
  "name": "builtin.language-features-markdown-monorepo",
  "version": "0.0.0-dev",
  "description": "Markdown language features monorepo for LVCE Editor",
  "license": "MIT",
  "author": "LVCE Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:static": "node scripts/build-static.js",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "cd packages/e2e && npm run e2e",
    "e2e:headless": "cd packages/e2e && npm run e2e:headless",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.5.0",
    "eslint": "^10.8.0",
    "jest": "^30.1.3",
    "prettier": "^3.8.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
