{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.js"],
      "project": ["*.js", "scripts/*.js"]
    },
    "packages/build": {
      "project": ["src/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/extension": {
      "entry": ["src/languageFeaturesMarkdownMain.ts"],
      "project": ["src/**/*.js", "src/**/*.ts"]
    },
    "packages/node": {
      "entry": ["src/markdownLanguageServerMain.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@types/markdown-it", "vscode-markdown-languageserver"],
      "ignoreUnresolved": ["./workerMain.js"]
    },
    "packages/server": {
      "ignoreDependencies": ["@lvce-editor/server"]
    }
  }
}
